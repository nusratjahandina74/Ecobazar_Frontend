# Public, non-secret configuration only. Never put secrets in VITE_* variables.
# Base URL of the EcoBazaar backend (no trailing slash). Defaults to the live Render API if not set.
VITE_API_BASE_URL=https://ecobazar-backend-1x13.onrender.com
# URL of the separate admin dashboard (shown as an "Admin" link for staff accounts)
VITE_ADMIN_URL=https://ecobazar-dashboard-admin.vercel.app
